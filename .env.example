# ─── Groq LLM ─────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# ─── Database ─────────────────────────────────────────
# Local dev: postgresql://postgres:yourpassword@localhost:5432/email_agent
# Docker compose: postgresql://postgres:yourpassword@db:5432/email_agent
# AWS RDS: postgresql://inboxiq_admin:yourpassword@your-rds-endpoint.rds.amazonaws.com:5432/email_agent
DATABASE_URL=

# ─── Gmail OAuth ──────────────────────────────────────
# Get from: https://console.cloud.google.com (OAuth 2.0 Client IDs)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ─── AWS (used in Phase 5 onwards) ────────────────────
AWS_REGION=ap-south-1
CLOUDWATCH_LOG_GROUP=email-agent